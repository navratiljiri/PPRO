#!/bin/sh
# ==============================================================================
# Pre-commit hook pro projekt PPRO (Zadání C - Akademie Trutnov)
# Kontrola integrity technické dokumentace a repozitáře
# ==============================================================================

echo "==> [Pre-commit Hook] Kontrola před vytvořením commitu..."

# 1. Kontrola existence README.md (Jediný zdroj pravdy)
if [ ! -f "README.md" ]; then
    echo "CHYBA: Soubor README.md neexistuje! README.md je jediný zdroj pravdy projektu." >&2
    exit 1
fi

# 2. Kontrola, zda se necommitují nechtěné citlivé soubory (.env, *.key apod.)
STAGED_ENV=$(git diff --cached --name-only | grep -E '^(\.env|\.env\.local)$')
if [ -n "$STAGED_ENV" ]; then
    echo "CHYBA: Pokus o commit citlivého souboru: $STAGED_ENV! Odstraňte jej ze stage." >&2
    exit 1
fi

# 3. Kontrola změn v kódu vs. dokumentace
# Pokud jsou ve stage soubory kódu (src, app, docker-compose atd.), připomene ověření dokumentace
STAGED_FILES=$(git diff --cached --name-only)
if echo "$STAGED_FILES" | grep -qvE '^(README\.md|AGENTS\.md|\.gitignore|\.githooks)'; then
    echo "--> Detekovány změny ve zdrojových souborech / konfiguraci."
    if ! echo "$STAGED_FILES" | grep -q 'README\.md'; then
        echo "--> UPOZORNĚNÍ: Změny v kódu bez současné změny README.md."
        echo "    Ujistěte se, že všechny architektonické změny a rozhodnutí jsou zaznamenány v README.md."
    fi
fi

echo "==> [Pre-commit Hook] Kontrola proběhla úspěšně."
exit 0

#!/bin/sh
# ==============================================================================
# Pre-commit hook pro projekt PPRO (Zadání C - Akademie Trutnov)
# Kontrola integrity technické dokumentace a repozitáře (PŘÍSNÝ REŽIM)
# ==============================================================================

echo "==> [Pre-commit Hook] Zahajuji kontrolu před vytvořením commitu..."

# 1. Kontrola existence základních dokumentů (Single Source of Truth & Changelog)
if [ ! -f "README.md" ]; then
    echo "CHYBA: Soubor README.md neexistuje! README.md je jediný zdroj pravdy projektu." >&2
    exit 1
fi

if [ ! -f "CHANGELOG.md" ]; then
    echo "CHYBA: Soubor CHANGELOG.md neexistuje! Projekt vyžaduje standardizovaný changelog." >&2
    exit 1
fi

# 2. Kontrola, zda se necommitují nechtěné citlivé soubory (.env, *.key apod.)
STAGED_ENV=$(git diff --cached --name-only | grep -E '^(\.env|\.env\.local)$')
if [ -n "$STAGED_ENV" ]; then
    echo "CHYBA: Pokus o commit citlivého souboru: $STAGED_ENV! Odstraňte jej ze stage." >&2
    exit 1
fi

# 3. Striktní kontrola změn v kódu vs. dokumentace
# Pokud jsou ve stage soubory projektu (kód, konfigurace, docker apod.) a nejedná se pouze o změnu dokumentace:
STAGED_FILES=$(git diff --cached --name-only)

# Ignorujeme samotnou dokumentaci, gitignore a hooky
CODE_CHANGES=$(echo "$STAGED_FILES" | grep -vE '^(README\.md|CHANGELOG\.md|AGENTS\.md|\.gitignore|\.githooks/|\.git/)')

if [ -n "$CODE_CHANGES" ]; then
    # Zkontrolujeme, zda je ve stage současně CHANGELOG.md nebo README.md
    DOCS_UPDATED=$(echo "$STAGED_FILES" | grep -E '^(README\.md|CHANGELOG\.md)$')
    if [ -z "$DOCS_UPDATED" ]; then
        echo "================================================================================" >&2
        echo "CHYBA COMMITU: Byly detekovány změny v kódu nebo konfiguraci:" >&2
        echo "$CODE_CHANGES" | sed 's/^/  - /' >&2
        echo "" >&2
        echo "Commit byl zablokován, protože v něm chybí aktualizace dokumentace!" >&2
        echo "Podle pravidel projektu musí každá změna kódu obsahovat:" >&2
        echo "  - záznam v CHANGELOG.md (popis úpravy dle Keep a Changelog) a/nebo" >&2
        echo "  - aktualizaci README.md (pokud se mění architektura, model či rozhodnutí)." >&2
        echo "" >&2
        echo "Nejprve aktualizujte CHANGELOG.md / README.md, přidejte je do stage (git add) a zkuste to znovu." >&2
        echo "================================================================================" >&2
        exit 1
    fi
fi

echo "==> [Pre-commit Hook] Všechny kontroly úspěšně proběhly."
exit 0
